# Copy this file to .env and fill in real values before deploying.
# None of these are required to run `npm run dev` — the contact form
# and map will just silently fail/no-op without them.

# EmailJS (https://www.emailjs.com) — powers the contact form
VITE_EMAIL_JS_SERVICE_ID=
VITE_EMAIL_JS_TEMPLATE_ID=
VITE_EMAIL_JS_USER_ID=

# Google reCAPTCHA v2 (https://www.google.com/recaptcha/admin)
VITE_GOOGLE_RECAPTCHA_KEY=

# Google Maps JavaScript API (https://console.cloud.google.com)
VITE_GOOGLE_API_KEY=

# Set to "true" only around the New Year to enable the festive theme
VITE_NEW_YEAR_MODE=false

# Sentry (https://sentry.io) — optional error tracking. Leave blank to disable.
VITE_SENTRY_DSN=
